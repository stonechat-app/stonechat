# Copy to .env next to docker-compose.yml and edit. Not a shell script: do not
# quote values, and escape any literal `$` as `$$` — compose interpolates it.

# -- where the hub listens ----------------------------------------------------

STONECHAT_HUB_PORT=8000
# 0.0.0.0 publishes to the internet (then open the port in your CLOUD firewall
# too; note that ufw does NOT police published container ports). Using the tls
# profile below? Set 127.0.0.1 — Caddy reaches the hub over the compose
# network, so it need not be exposed at all.
STONECHAT_BIND=0.0.0.0

# HTTPS via Caddy: set this, point the DNS A record here FIRST (issuance is
# proved over port 80 at startup), then either start with
# `docker compose --profile tls up -d` or uncomment COMPOSE_PROFILES so every
# plain `docker compose` command includes it.
STONECHAT_HUB_DOMAIN=
# COMPOSE_PROFILES=tls

# -- state --------------------------------------------------------------------

# Host directory holding hub.db.
STONECHAT_STATE_DIR=/var/lib/stonechat

# -- operating it -------------------------------------------------------------

# Enables the abuse-report routes under /v1/admin. Unset → reports are still
# recorded, but nothing can read them. `openssl rand -hex 32`
STONECHAT_ADMIN_TOKEN=

# Comma-separated extra origins. The web client needs this — every call it
# makes is cross-origin, and without it the phone reports "that code has
# expired" rather than anything about CORS.
STONECHAT_CORS_EXTRA=

# -- handing out mailboxes yourself (optional) --------------------------------

# Leave this empty and your users bring their own mailbox, registering its
# address with POST /v1/mailbox/external. That is the cheapest way to run a
# network: no machine of yours holds anyone's mail.
#
# To provision mailboxes for people instead, run the machine host
# (../machine_host/README.md "Hosting for a hub") on one or more OTHER boxes —
# never this one, which holds the directory — and list them here:
#
#   name=https://host:8200|COUNTRY|<that host's admin token>|<its tls_fp>
#
# Comma-separated. Every field is required. The ISO country code is both where
# mailboxes land and the country list /v1/countries offers, so a country becomes
# purchasable exactly when a host here declares it. The fingerprint (from
# `curl -sk https://host:8200/health`) is the trust anchor — the machine host
# self-signs, so without it anything on the path can collect an admin token that
# provisions mailboxes.
STONECHAT_MACHINE_HOSTS=

# Directory on THIS box holding the static `stonechat-relay` binary the hub
# ships to its machine hosts (scripts/roll_relay.py) and serves to dedicated
# VMs. Defaults to the state dir above. Only needed if the line above is set.
# STONECHAT_RELAY_DIR=/var/lib/stonechat

# Or take this hub out of the download path entirely and let both tiers pull a
# published release (relay/README.md "Releases"):
#
#   - machine hosts: set STONECHAT_MACHINE_HOST_IMAGE on each host to a
#     digest-pinned image, e.g. ghcr.io/stonechat-app/relay@sha256:… . A roll
#     then needs no upload — the host takes the binary out of that image.
#   - dedicated VMs: the two lines below. The URL is the release asset the VM
#     downloads; the SHA-256 is its line from the release's SHA256SUMS, and it
#     is what the startup script pins, so the hub needs no copy of the file.
#     Never a floating tag or a "latest" URL: a mailbox you cannot name the
#     build of is a mailbox you cannot reason about the day a relay bug lands.
# STONECHAT_RELAY_BINARY_URL=https://github.com/stonechat-app/stonechat/releases/download/relay-v0.1.0/stonechat-relay-x86_64-linux-musl
# STONECHAT_RELAY_SHA256=

# Public base URL of this hub. Only dedicated-VM provisioning needs it, to build
# the URL those VMs fetch the relay binary from.
# STONECHAT_HUB_URL=

# -- push ---------------------------------------------------------------------

# A hub passes push settings to the mailboxes it provisions. If yours provisions
# none, there is nothing to set: a mailbox someone runs themselves takes
# STONECHAT_PUSH_GATEWAY directly (../push_gateway/README.md). With machine hosts
# above, set both of these and the hub mints a key into every mailbox it places.
# The address must be one MAILBOXES can reach — they run on other machines, so
# never 127.0.0.1 — and the gateway must hold the same mint secret.
# STONECHAT_PUSH_GATEWAY=
# STONECHAT_PUSH_MINT_SECRET=
