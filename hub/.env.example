# Copy to .env next to docker-compose.yml and edit. Not a shell script: do not
# quote values, and escape any literal `$` as `$$` — compose interpolates it.

# -- where the hub listens ----------------------------------------------------

STONECHAT_HUB_PORT=8000
# 0.0.0.0 publishes to the internet (then open the port in your CLOUD firewall
# too; note that ufw does NOT police published container ports). Using the tls
# profile below? Set 127.0.0.1 — Caddy reaches the hub over the compose
# network, so it need not be exposed at all.
STONECHAT_BIND=0.0.0.0

# HTTPS via Caddy: set this, point the DNS A record here FIRST (issuance is
# proved over port 80 at startup), then either start with
# `docker compose --profile tls up -d` or uncomment COMPOSE_PROFILES so every
# plain `docker compose` command includes it.
STONECHAT_HUB_DOMAIN=
# COMPOSE_PROFILES=tls

# -- state --------------------------------------------------------------------

# Host directory holding hub.db.
STONECHAT_STATE_DIR=/var/lib/stonechat

# -- operating it -------------------------------------------------------------

# Enables the abuse-report routes under /v1/admin. Unset → reports are still
# recorded, but nothing can read them. `openssl rand -hex 32`
STONECHAT_ADMIN_TOKEN=

# Comma-separated extra origins. The web client needs this — every call it
# makes is cross-origin, and without it the phone reports "that code has
# expired" rather than anything about CORS.
STONECHAT_CORS_EXTRA=

# -- push ---------------------------------------------------------------------

# Nothing to set here. A hub only passes push settings to mailboxes it
# provisions, and this one provisions none: a mailbox you run yourself takes
# STONECHAT_PUSH_GATEWAY directly (../push_gateway/README.md).
