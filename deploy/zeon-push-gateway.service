# Zeon push gateway — the ONLY place APNs/FCM credentials live.
# Copy to /etc/systemd/system/, fill in the credential paths, then:
#   systemctl daemon-reload && systemctl enable --now zeon-push-gateway
#
# It binds 0.0.0.0:8100 but you should NOT open 8100 in the cloud firewall:
# only the mailbox containers (same host, via the Docker bridge) talk to it.
# Point the hub at it with ZEON_PUSH_GATEWAY (see deploy/README.md).

[Unit]
Description=Zeon push gateway
After=network-online.target

[Service]
User=root
WorkingDirectory=/root/zeonchat/gateway
# --- iOS (APNs), from your Apple Developer account ---
Environment=ZEON_APNS_KEY=/etc/zeon/apns.p8
Environment=ZEON_APNS_KEY_ID=XXXXXXXXXX
Environment=ZEON_APNS_TEAM_ID=YYYYYYYYYY
Environment=ZEON_APNS_TOPIC=com.zeonchat.mobileapp
# Environment=ZEON_APNS_SANDBOX=1        # uncomment for Xcode debug builds ONLY (TestFlight/App Store use production APNs)
# --- Android (FCM), a Firebase service-account JSON ---
# Environment=ZEON_FCM_CREDENTIALS=/etc/zeon/fcm.json
# --- Push-key auth (PROTOCOL.md "Push gateway") ---
# Same value as the hub's ZEON_PUSH_MINT_SECRET (openssl rand -hex 32).
# When set, /v1/ping requires a hub-minted X-Zeon-Push-Key, handed to each
# mailbox at provision time. Unset → open endpoint (dev/e2e).
# Environment=ZEON_PUSH_MINT_SECRET=ZZZZZZZZ
# Environment=ZEON_PUSH_BLOCKLIST=/etc/zeon/push-blocklist   # revoked key ids, one per line
ExecStart=/root/zeonchat/gateway/.venv/bin/uvicorn main:app --host 0.0.0.0 --port 8100
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
