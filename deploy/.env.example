# Copy to .env next to docker-compose.yml and edit. Not a shell script: do not
# quote values, and escape any literal `$` as `$$` — compose interpolates it.

# -- where the hub listens ----------------------------------------------------

STONECHAT_HUB_PORT=8000
# 0.0.0.0 publishes to the internet (then open the port in your CLOUD firewall
# too; note that ufw does NOT police published container ports). Using the tls
# profile below? Set 127.0.0.1 — Caddy reaches the hub over the compose
# network, so it need not be exposed at all.
STONECHAT_BIND=0.0.0.0
# Public base URL — how dedicated-VM startup scripts reach /v1/relay-binary.
STONECHAT_HUB_URL=

# HTTPS via Caddy: set this, point the DNS A record here FIRST (issuance is
# proved over port 80 at startup), then `docker compose --profile tls up -d`.
# Phones need a certificate, so a public hub wants this.
STONECHAT_HUB_DOMAIN=

# -- host paths bind-mounted into the container -------------------------------

# hub.db lives here. Same default the systemd unit used.
STONECHAT_STATE_DIR=/var/lib/stonechat
# The SSH key the hub drives fleet hosts with, plus a known_hosts that already
# contains them (`ssh-keyscan <FLEET_ADDR> >> ~/.ssh/known_hosts`).
STONECHAT_SSH_DIR=/root/.ssh
# Directory holding the prebuilt static `stonechat-relay` (relay/README.md
# "Producing the production artifact"). Absent → fleet hosts compile the crate
# on first ignite and dedicated-VM provisioning is refused. Defaults to the
# state dir above, which is where the deployed hub already keeps it.
STONECHAT_RELAY_DIR=/var/lib/stonechat
# Override: serve the relay from an external artifact URL instead of the hub.
STONECHAT_RELAY_BINARY_URL=

# -- where mailboxes go -------------------------------------------------------

# name=ssh://user@addr|advertise_ip|COUNTRY, comma-separated. The ISO country
# code is required — it is both placement and the Mailbox plan's country list.
# Unset → no fleet provider; users bring their own mailbox, which is the
# cheapest way to run a network (notes/docs/SELF_HOSTED_HUB.md).
STONECHAT_FLEET_HOSTS=

# Dedicated-VM providers. Each token set enables that provider; unset means the
# hub never offers it. Only GCP needs a build arg (WITH_GCP=1) as well.
STONECHAT_GCP_PROJECT=
STONECHAT_HETZNER_TOKEN=
STONECHAT_VULTR_TOKEN=
STONECHAT_DO_TOKEN=

# provider=local is not available in the container: it would need this box's
# own Docker socket, and mailboxes never run on the hub box.

# -- push ---------------------------------------------------------------------

# Optional, and off unless the `push_gateway` profile runs. Without it messages still
# arrive while the app is open or when it resumes — just no background
# wake-ups. To start it with every plain `docker compose` command:
#   COMPOSE_PROFILES=push_gateway    (or push_gateway,tls)

# Address of the push gateway as MAILBOXES see it. The hub never calls it; it
# hands the string to every mailbox it provisions, and mailboxes run on other
# machines — so never 127.0.0.1 or a Docker bridge address. On one cloud
# network that is this box's private IP, e.g. http://10.128.0.7:8100.
# Dedicated VMs on another cloud (hetzner, vultr, digitalocean) cannot reach a
# private address at all; they need a public URL.
# Mailboxes keep the value they were created with: set it before the first
# ignite, or re-ignite afterwards.
STONECHAT_PUSH_GATEWAY=
# Shared by the hub (mints a push key into each mailbox) and the push service
# (checks it). Empty → the push service accepts unsigned pings from anyone who
# can reach it. `openssl rand -hex 32`
STONECHAT_PUSH_MINT_SECRET=

# Host address the push service is published on: this box's PRIVATE address,
# the one in STONECHAT_PUSH_GATEWAY. Not 0.0.0.0 — ufw does not police
# published container ports, so that would be the internet. The loopback
# default reaches no mailbox, so push stays silent until this is set.
STONECHAT_PUSH_BIND=127.0.0.1
STONECHAT_PUSH_PORT=8100
# Host directory holding the credentials, mounted read-only at /etc/stonechat
# inside the container. The file paths below are CONTAINER paths.
STONECHAT_PUSH_SECRETS_DIR=/etc/stonechat

# iOS (APNs): an Auth Key (.p8) from the Apple Developer account.
STONECHAT_APNS_KEY=/etc/stonechat/apns.p8
STONECHAT_APNS_KEY_ID=
STONECHAT_APNS_TEAM_ID=
# The app's bundle id.
STONECHAT_APNS_TOPIC=
# 1 only for Xcode debug builds; TestFlight and the App Store use production.
STONECHAT_APNS_SANDBOX=
# Android (FCM): path to a Firebase service-account JSON. Empty → Android
# pings are accepted and dropped.
STONECHAT_FCM_CREDENTIALS=
# Revoked push-key ids, one per line (the pk_… id from the push logs). Re-read
# when the file changes, no restart. A missing file means nothing is revoked.
STONECHAT_PUSH_BLOCKLIST=/etc/stonechat/push-blocklist
# 1 → GET /v1/debug/pings, which scripts/e2e.py reads. Never in production.
STONECHAT_PUSH_DEBUG=

# -- billing ------------------------------------------------------------------

# "off" removes the whole plane: no /v1/billing/*, every provider ungated, no
# reaper. The right choice for a private hub.
STONECHAT_BILLING=on
STONECHAT_STRIPE_WEBHOOK_SECRET=
# Enables comp grants and the abuse routes under /v1/admin.
STONECHAT_ADMIN_TOKEN=

# -- browser clients ----------------------------------------------------------

# Comma-separated extra origins. The web client needs this — every call it
# makes is cross-origin, and without it the phone reports "that code has
# expired" rather than anything about CORS.
STONECHAT_CORS_EXTRA=

# -- image contents (build args, not runtime) ---------------------------------

# Rebuild after changing either: docker compose up -d --build
WITH_BILLING=1
WITH_GCP=0
