#!/usr/bin/env bash
#
# Hub VM startup script. GCE runs it as root on EVERY boot, so each step is
# idempotent. It prepares the box and nothing else: the code, deploy/.env and
# `docker compose up` are deploy.sh's job.
#
# Rendered by Terraform's templatefile: write shell braces as $${var}.
set -euo pipefail

# -- swap: 1 GB of RAM cannot build the hub image ---------------------------------

if [ "${swap_gb}" -gt 0 ]; then
  if [ ! -f /swapfile ]; then
    fallocate -l "${swap_gb}G" /swapfile
    chmod 600 /swapfile
    mkswap /swapfile
    echo "/swapfile none swap sw 0 0" >> /etc/fstab
  fi
  swapon --show=NAME --noheadings | grep -qx /swapfile || swapon /swapfile
fi

# -- Docker + compose v2 (Debian's own docker.io has no compose plugin) ------------

if ! command -v docker >/dev/null; then
  curl -fsSL https://get.docker.com | sh
fi
systemctl enable --now docker

# -- what docker-compose.yml bind-mounts ---------------------------------------------

install -d -m 755 /var/lib/stonechat   # hub.db + the relay binary
install -d -m 755 /etc/stonechat       # push gateway credentials

# The key the hub drives fleet hosts with (docker -H ssh://…). deploy.sh
# authorizes it on each fleet host and pre-trusts their host keys, since the
# container mounts /root/.ssh read-only and cannot accept a new host itself.
install -d -m 700 /root/.ssh
[ -f /root/.ssh/id_ed25519 ] || ssh-keygen -q -t ed25519 -N "" -C "root@$(hostname)" -f /root/.ssh/id_ed25519
touch /root/.ssh/known_hosts

# deploy.sh waits for this.
touch /var/local/stonechat-bootstrapped
