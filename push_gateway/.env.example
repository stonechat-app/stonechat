# Copy to .env next to docker-compose.yml and edit. Not a shell script: do not
# quote values, and escape any literal `$` as `$$` — compose interpolates it.
#
# The credentials below must belong to the app build your users run: APNs and
# FCM only accept pushes signed for that app's bundle id / Firebase project
# (README.md "Before you run this").

# -- where it listens ---------------------------------------------------------

# Host address to publish on: this box's PRIVATE address, the one mailboxes
# reach it at. Not 0.0.0.0 — ufw does not police published container ports, so
# that would be the internet. The loopback default reaches no mailbox, so push
# stays silent until this is set.
STONECHAT_PUSH_BIND=127.0.0.1
STONECHAT_PUSH_PORT=8100

# -- auth ---------------------------------------------------------------------

# Must equal the STONECHAT_PUSH_MINT_SECRET of the hub that provisions your
# mailboxes: it mints a push key into each one and this service checks it.
# Empty → any caller that can reach the port can make it push.
# `openssl rand -hex 32`
STONECHAT_PUSH_MINT_SECRET=
# Revoked push-key ids, one per line (the pk_… id from the logs). Re-read when
# the file changes, no restart. A missing file means nothing is revoked.
STONECHAT_PUSH_BLOCKLIST=/etc/stonechat/push-blocklist

# -- credentials --------------------------------------------------------------

# Host directory holding the credentials, mounted read-only at /etc/stonechat
# inside the container. The file paths below are CONTAINER paths.
STONECHAT_PUSH_SECRETS_DIR=/etc/stonechat

# iOS (APNs): an Auth Key (.p8) from the Apple Developer account that owns the
# app's bundle id.
STONECHAT_APNS_KEY=/etc/stonechat/apns.p8
STONECHAT_APNS_KEY_ID=
STONECHAT_APNS_TEAM_ID=
# The app's bundle id.
STONECHAT_APNS_TOPIC=
# 1 only for Xcode debug builds; TestFlight and the App Store use production.
STONECHAT_APNS_SANDBOX=
# Android (FCM): path to a service-account JSON for the app's Firebase project.
# Empty → Android pings are accepted and dropped.
STONECHAT_FCM_CREDENTIALS=

# 1 → GET /v1/debug/pings, which scripts/e2e.py reads. Never in production.
STONECHAT_PUSH_DEBUG=
