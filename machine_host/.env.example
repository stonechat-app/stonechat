# Copy to .env (gitignored) and fill in. docker-compose.yml reads it.

# Required. The secret you paste into the app; authorizes invites and evictions.
# Generate with: openssl rand -hex 24
STONECHAT_MACHINE_HOST_ADMIN_TOKEN=

# Required. This box's static public IP (or DNS name). Baked into every invite
# and every guest mailbox address, so it must not change.
STONECHAT_MACHINE_HOST_ADVERTISE_HOST=

# Optional — defaults shown.
# STONECHAT_MACHINE_HOST_PORT=8200
# STONECHAT_MACHINE_HOST_CAPACITY=25
# STONECHAT_MACHINE_HOST_PORT_BASE=42000
# STONECHAT_MACHINE_HOST_IMAGE=stonechat-relay:dev
# STONECHAT_MACHINE_HOST_RUNTIME=runsc
# STONECHAT_PUSH_GATEWAY=

# Host directory for machine_host.db and the TLS keypair.
# STONECHAT_STATE_DIR=/var/lib/stonechat
