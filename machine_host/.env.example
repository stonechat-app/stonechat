# Copy to .env (gitignored) and fill in. docker-compose.yml reads it.

# Required. The secret you paste into the app; authorizes invites and evictions.
# Generate with: openssl rand -hex 24
STONECHAT_MACHINE_HOST_ADMIN_TOKEN=

# Required. This box's static public IP (or DNS name). Baked into every invite
# and every guest mailbox address, so it must not change.
STONECHAT_MACHINE_HOST_ADVERTISE_HOST=

# Optional — defaults shown.
# STONECHAT_MACHINE_HOST_PORT=8200
# STONECHAT_MACHINE_HOST_CAPACITY=25
# STONECHAT_MACHINE_HOST_PORT_BASE=42000
# STONECHAT_MACHINE_HOST_IMAGE=ghcr.io/stonechat-app/relay:latest
# STONECHAT_MACHINE_HOST_RUNTIME=runsc
# STONECHAT_PUSH_GATEWAY=

# Set to 1 only if a HUB manages this box (its operator runs both). Invites are
# refused then: the hub is the single authority, and mailboxes it does not know
# about would sit on ports it believes are free. A box you own for yourself and
# your friends leaves this unset.
# STONECHAT_MACHINE_HOST_MANAGED=

# Mints a push key into each guest mailbox. Only useful with your own push
# gateway (../push_gateway/), which must hold the SAME secret. Unset → mailboxes
# ping without a key, which a gateway with no secret accepts.
# STONECHAT_PUSH_MINT_SECRET=

# Host directory for machine_host.db and the TLS keypair.
# STONECHAT_STATE_DIR=/var/lib/stonechat
