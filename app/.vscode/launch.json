{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      // No ZEON_HUB baked in: debug builds default to http://127.0.0.1:8000.
      "name": "app",
      "request": "launch",
      "type": "dart"
    },
    {
      // Local dev hub on 8477. Debug mode picks the `local` provider
      // automatically → the mailbox is a Docker container on this Mac.
      // Start the hub first (from hub/):
      //   ZEON_FLEET_HOSTS="local=|127.0.0.1" ZEON_ADMIN_TOKEN=test-admin \
      //   ZEON_TEST_CODE=ZEON-TEST-TEST \
      //   .venv/bin/python -m uvicorn app.main:app --port 8477
      "name": "app — local hub (127.0.0.1:8477)",
      "request": "launch",
      "type": "dart",
      "args": ["--dart-define=ZEON_HUB=http://127.0.0.1:8477"]
    },
    {
      // Debug against PRODUCTION. ZEON_PROVIDER=fleet matters: without it a
      // debug build defaults to the `local` provider, which would ask the
      // hub to run the mailbox container on the hub VM itself — breaking the
      // "mailboxes never on the hub box" rule. Fleet needs an active plan
      // (redeem the tester code first).
      "name": "app — PRODUCTION hub",
      "request": "launch",
      "type": "dart",
      "args": [
        "--dart-define=ZEON_HUB=https://hub.zeonchat.com",
        "--dart-define=ZEON_PROVIDER=fleet"
      ]
    },
    {
      "name": "app (profile mode)",
      "request": "launch",
      "type": "dart",
      "flutterMode": "profile"
    },
    {
      "name": "app (release mode)",
      "request": "launch",
      "type": "dart",
      "flutterMode": "release"
    }
  ]
}
